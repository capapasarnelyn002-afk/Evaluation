{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/evaluate",
      "destination": "/index.html"
    },
    {
      "source": "/evaluate/:path*",
      "destination": "/index.html"
    }
  ]
}
