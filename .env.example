# Gemini API key for AI reporting and insights.
# Optional if AI features are not needed.
GEMINI_API_KEY=your-gemini-api-key-here

# Server-side Supabase configuration. These values must belong to the same project.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Public browser values used by Google OAuth. The publishable key is safe to expose.
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only. Never expose this key in frontend code or prefix it with VITE_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
