# Gemini API key for AI reporting and insights.
# Optional if AI features are not needed.
GEMINI_API_KEY=your-gemini-api-key-here

# Server-side Supabase configuration. These values must belong to the same project.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Alternate names supported for compatibility with common deployment setups.
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_SERVICE_ROLE_SECRET=your-supabase-service-role-secret

# Optional explicit browser values. Vite also maps SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY (or SUPABASE_ANON_KEY) into the browser build.
# These public values are safe to expose; never use SUPABASE_SECRET_KEY here.
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never expose this key in frontend code or prefix it with VITE_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
